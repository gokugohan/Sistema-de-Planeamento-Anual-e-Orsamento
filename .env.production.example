# Production settings for the Docker stack (compose.prod.yml).
# Copy to .env.production and fill in every value marked CHANGE. Never commit .env.production.
#
#   docker compose --env-file .env.production -f compose.prod.yml run --rm --no-deps -e WAIT_FOR_DB=false app php artisan key:generate --show
#   (copy the printed key into APP_KEY below)

APP_NAME="Plano de Ação Anual (PAA)"
APP_ENV=production
APP_DEBUG=false
APP_KEY=                                  # CHANGE: the key printed by the command above
APP_URL=https://paa.example.gov.tl        # CHANGE: the address people open
APP_LOCALE=tet
APP_FALLBACK_LOCALE=pt
APP_DOMAIN=paa.example.gov.tl             # CHANGE: only for the https profile (Caddy)
WEB_PORT=8080                             # the port the web container listens on (80 when no Caddy and no other proxy)

# Behind Caddy, a load balancer or another proxy of yours: trust its X-Forwarded-* headers (the stack has no other way in)
TRUSTED_PROXIES=*
SESSION_SECURE_COOKIE=true                # true when the address is https

LOG_CHANNEL=stderr                        # read with: docker compose logs app
LOG_LEVEL=warning

# ── database (the db service creates it on first start)
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=paa
DB_USERNAME=paa
DB_PASSWORD=                              # CHANGE: a long random password
DB_ROOT_PASSWORD=                         # CHANGE: another one

# ── redis: sessions, cache and the queue (internal network only)
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=                           # CHANGE
SESSION_DRIVER=redis
CACHE_STORE=redis
QUEUE_CONNECTION=redis

# ── e-mail notifications (switched on by an administrator in Management > Settings)
# Any SMTP service works: your institution's mail server, or a provider such as Mailgun, Amazon SES or Brevo.
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.gov.tl             # CHANGE
MAIL_PORT=587
MAIL_USERNAME=                            # CHANGE
MAIL_PASSWORD=                            # CHANGE
MAIL_SCHEME=null                          # null with port 587 (STARTTLS); smtps with port 465
MAIL_FROM_ADDRESS=paa@example.gov.tl      # CHANGE: an address your mail server lets you send from
MAIL_FROM_NAME="${APP_NAME}"

# ── the first administrator, created by: docker compose ... run --rm app php artisan db:seed --force
ADMIN_NAME="Administrator"
ADMIN_EMAIL=admin@example.gov.tl          # CHANGE
ADMIN_PASSWORD=                           # CHANGE: at least 12 characters; change it again after the first sign-in

# ── backups: the nightly dump is kept in the storage volume and copied here too (a folder of the server)
BACKUP_COPY_PATH=/backups
BACKUP_HOST_DIR=./backups
BACKUP_KEEP_DAYS=30
